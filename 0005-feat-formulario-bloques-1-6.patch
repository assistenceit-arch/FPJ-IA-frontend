+  documento: "",
+  entidad: ENTIDADES[0],
+  cargo: "",
+  telefono: "",
+  correo: "",
+  placa: "",
+  zonaAtencion: "",
+  estacion: "",
+  servicio: SERVICIOS[0],
+  cai: "",
