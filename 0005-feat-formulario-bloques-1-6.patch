+import type { FuncionarioActuante, CompaneroPatrulla } from "@/lib/tipos";
+
+const ENTIDADES = ["Policía Nacional", "CTI Fiscalía", "Migración Colombia", "Ejército Nacional", "Otra"];
+const SERVICIOS = [
+  "Labores de Patrullaje",
