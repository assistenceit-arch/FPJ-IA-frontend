From b59a6f8f978fd6936bb5fd5a0ab39498112f9bfa Mon Sep 17 00:00:00 2001
From: FPJ IA Assistant <fpj-ia@assistenceit.dev>
Date: Sun, 2 Aug 2026 03:28:38 +0000
Subject: [PATCH] fix(login): usar el campo 'password' que espera el backend
 (no 'contrasena')
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

El backend (src/auth/auth.controller.ts) espera el body
{ correo, password }, pero el frontend enviaba { correo, contrasena },
causando 'Error: data and hash arguments required' en bcrypt.compare()
del lado del backend (password llegaba undefined).

Se mantiene el nombre de la variable interna 'contrasena' (más legible
en español) pero se envía como 'password' en el cuerpo de la petición,
que es el nombre exacto que espera la API.
---
 src/app/login/page.tsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/app/login/page.tsx b/src/app/login/page.tsx
index eac3bda..77bec4c 100644
--- a/src/app/login/page.tsx
+++ b/src/app/login/page.tsx
@@ -25,7 +25,7 @@ export default function PaginaLogin() {
     try {
       const respuesta = await api.post<RespuestaLogin>(
         "/auth/login",
-        { correo, contrasena },
+        { correo, password: contrasena },
         { conAuth: false },
       );
       const token = respuesta.token ?? respuesta.access_token ?? respuesta.accessToken;
-- 
