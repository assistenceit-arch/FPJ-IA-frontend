# URL base de la API del backend FPJ-IA. En desarrollo local normalmente
# es http://localhost:3000/api (el backend corre con `npm run start:dev`
# en el puerto 3000 y expone sus rutas bajo el prefijo /api).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Monitoreo y alertas de errores (opcional). Sin esta variable, Sentry
# simplemente no reporta nada -- no hace falta para desarrollo local.
NEXT_PUBLIC_SENTRY_DSN=
